{
  "name": "roastcoder",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": "20.x"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:seed": "pnpm --filter api prisma db seed"
  }
}